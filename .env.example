# Email Configuration — The Green Life (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to git!

# Gmail SMTP (App Password, not your Gmail password)
# Create App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Recipient email
TO_EMAIL=your-recipient@gmail.com
